    def "Looks"
    {
        def Material "GP_TerrainPBRMaterial"
        {
            token outputs:surface.connect = </World/Looks/GP_TerrainPBRMaterial/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.17, 0.18, 0.12)
                color3f inputs:diffuseColor.connect = </World/Looks/GP_TerrainPBRMaterial/AlbedoTexture.outputs:rgb>
                float inputs:metallic = 0
                normal3f inputs:normal.connect = </World/Looks/GP_TerrainPBRMaterial/NormalTexture.outputs:rgb>
                float inputs:roughness = 0.92
                float inputs:roughness.connect = </World/Looks/GP_TerrainPBRMaterial/RoughnessTexture.outputs:r>
                token outputs:surface
            }

            def Shader "StReader"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "AlbedoTexture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @/home/rokey/dev_ws/dmz_sentry/assets/materials/Ground081_2K-JPG/Ground081_2K-JPG_Color.jpg@
                float2 inputs:st.connect = </World/Looks/GP_TerrainPBRMaterial/StReader.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float3 outputs:rgb
            }

            def Shader "RoughnessTexture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @/home/rokey/dev_ws/dmz_sentry/assets/materials/Ground081_2K-JPG/Ground081_2K-JPG_Roughness.jpg@
                float2 inputs:st.connect = </World/Looks/GP_TerrainPBRMaterial/StReader.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float outputs:r
            }

            def Shader "NormalTexture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @/home/rokey/dev_ws/dmz_sentry/assets/materials/Ground081_2K-JPG/Ground081_2K-JPG_NormalGL.jpg@
                float2 inputs:st.connect = </World/Looks/GP_TerrainPBRMaterial/StReader.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float3 outputs:rgb
            }
        }
    }

