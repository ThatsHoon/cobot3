#usda 1.0
(
    # gp_scene.usd 보강용 sublayer (2026-05-21, 갱신 2026-05-22).
    # WHY: 신규 prim (Doro / Go2_starting_point / militarybase) 의
    # collider/material binding 설정이 USD 에 누락.
    # gp_scene.usd 는 단일 소스로 보존하고 보강 사항만 이 sublayer 에 모음.
    # 로드는 camera_publisher.py 가 런타임에
    # subLayerPaths.insert(0, ...) 로 prepend (가장 강한 opinion).
    #
    # 롤백: GP_USE_OVERRIDES=0 env, 또는 이 파일 삭제/이름변경.
    defaultPrim = "World"
    upAxis = "Z"
    metersPerUnit = 1
)

over "World"
{
    # ── A. 시각화 마커 (물리 비활성) ──
    # scale 0.01~0.1 의 작은 마커. 충돌 불필요.
    over "Go2_starting_point" ( apiSchemas = ["PhysicsCollisionAPI"] )
    {
        bool physics:collisionEnabled = false
    }
    over "militarybase" ( apiSchemas = ["PhysicsCollisionAPI"] )
    {
        bool physics:collisionEnabled = false
    }

    # ── B. 정적 props (Doro) ──
    # 자식 mesh 의 MeshCollisionAPI(none) + 마찰 binding 은
    # camera_publisher.py 의 safety-net 이 leaf Mesh 마다 적용.
    over "Doro" ( apiSchemas = ["MaterialBindingAPI"] )
    {
    }
}
