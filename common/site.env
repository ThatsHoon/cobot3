# cobot3 2-PC 사이트 네트워크 — 단일 소스(SSOT).
# 배포지가 바뀌면 **이 파일만** 수정하면 main_side/sub1_side 가 자동 반영된다
# (런처가 common/site.sh 를 통해 C2_INGEST_URL·FastDDS 프로파일을 자동 파생).
# KEY=VALUE 만(주석/빈줄 허용) — bash source 및 sed/파싱 양쪽 안전.

MAIN_SIDE_IP=192.168.10.94
SUB1_SIDE_IP=192.168.10.105

# C2 공개 호스팅 도메인 (Cloudflare Tunnel). 미사용 배포면 비워둬도 무방
# — run_cloudflared.sh / web .env 만 참조하며 IP 파생 로직과 무관.
PUBLIC_HOST=cobot3.thatshoon.com

# YOLO 인퍼런스 활성 채널 (2026-05-26): inspect + TP 4 채널 전체 — 전 감시 카메라 bbox 표시
C2_YOLO_CAMERAS=inspect,tp_a,tp_b,tp_c,tp_d
