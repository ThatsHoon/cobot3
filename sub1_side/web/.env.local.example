# C2 web → web_server 연결.
#  · 로컬/LAN:  http://localhost:8000  (또는 http://<SUB1_SIDE_IP>:8000)
#  · 공개 호스팅: https://<PUBLIC_HOST>  (Cloudflare 단일오리진 — CLOUDFLARE.md)
NEXT_PUBLIC_C2_API=http://localhost:8000
NEXT_PUBLIC_GP_ROBOT=gp0
# /debug 페이지가 임베드하는 Lichtblick(Foxglove) 뷰어.
#  · 같은-PC 임시: http://localhost:8080 (docker Lichtblick 컨테이너)
#  · 공개 호스팅: https://<전용 Foxglove 호스트> (Cloudflare Access 뒤)
# 같은-PC 임시 검증 시 NEXT_PUBLIC_C2_API 도 http://localhost:8000 로 둘 것
# (prod https 오리진에 http Lichtblick iframe = 혼합콘텐츠 차단).
NEXT_PUBLIC_LICHTBLICK_URL=http://localhost:8080
