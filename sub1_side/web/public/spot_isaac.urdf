<?xml version="1.0"?>
<!-- Spot-with-arm URDF using Isaac Sim USD prim frame names.
     Link/joint names match ROS2PublishTransformTree TF output exactly.
     Joint origins/meshes are taken verbatim from the official
     spot_description package (rai-opensource/spot_description). -->
<robot name="spot_with_arm">

  <!-- ── Body ─────────────────────────────────────────────────────── -->
  <link name="base">
    <visual>
      <geometry>
        <mesh filename="package://spot_description/meshes/base/visual/body.obj"/>
      </geometry>
    </visual>
  </link>

  <!-- ══ FRONT-LEFT LEG ════════════════════════════════════════════ -->
  <joint name="fl_hx" type="revolute">
    <parent link="base"/><child link="fl_hip"/>
    <origin xyz="0.29785 0.05500 0.00000" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit effort="45" velocity="17.647" lower="-0.7854" upper="0.7854"/>
  </joint>
  <link name="fl_hip">
    <visual><geometry>
      <mesh filename="package://spot_description/meshes/base/visual/front_left_hip.obj"/>
    </geometry></visual>
  </link>

  <joint name="fl_hy" type="revolute">
    <parent link="fl_hip"/><child link="fl_uleg"/>
    <origin xyz="0.0 0.110945 0.0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="45" velocity="17.647" lower="-0.8989" upper="2.2951"/>
  </joint>
  <link name="fl_uleg">
    <visual><geometry>
      <mesh filename="package://spot_description/meshes/base/visual/front_left_upper_leg.obj"/>
    </geometry></visual>
  </link>

  <joint name="fl_kn" type="revolute">
    <parent link="fl_uleg"/><child link="fl_lleg"/>
    <origin xyz="0.0 0.0 -0.3365" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="115" velocity="17.647" lower="-2.7928" upper="-0.2548"/>
  </joint>
  <link name="fl_lleg">
    <visual><geometry>
      <mesh filename="package://spot_description/meshes/base/visual/front_left_lower_leg.obj"/>
    </geometry></visual>
  </link>

  <!-- ══ FRONT-RIGHT LEG ═══════════════════════════════════════════ -->
  <joint name="fr_hx" type="revolute">
    <parent link="base"/><child link="fr_hip"/>
    <origin xyz="0.29785 -0.05500 0.00000" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit effort="45" velocity="17.647" lower="-0.7854" upper="0.7854"/>
  </joint>
  <link name="fr_hip">
    <visual><geometry>
      <mesh filename="package://spot_description/meshes/base/visual/front_right_hip.obj"/>
    </geometry></visual>
  </link>

  <joint name="fr_hy" type="revolute">
    <parent link="fr_hip"/><child link="fr_uleg"/>
    <origin xyz="0.0 -0.110945 0.0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="45" velocity="17.647" lower="-0.8989" upper="2.2951"/>
  </joint>
  <link name="fr_uleg">
    <visual><geometry>
      <mesh filename="package://spot_description/meshes/base/visual/front_right_upper_leg.obj"/>
    </geometry></visual>
  </link>

  <joint name="fr_kn" type="revolute">
    <parent link="fr_uleg"/><child link="fr_lleg"/>
    <origin xyz="0.0 0.0 -0.3365" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="115" velocity="17.647" lower="-2.7928" upper="-0.2548"/>
  </joint>
  <link name="fr_lleg">
    <visual><geometry>
      <mesh filename="package://spot_description/meshes/base/visual/front_right_lower_leg.obj"/>
    </geometry></visual>
  </link>

  <!-- ══ HIND-LEFT LEG ═════════════════════════════════════════════ -->
  <joint name="hl_hx" type="revolute">
    <parent link="base"/><child link="hl_hip"/>
    <origin xyz="-0.29785 0.05500 0.00000" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit effort="45" velocity="17.647" lower="-0.7854" upper="0.7854"/>
  </joint>
  <link name="hl_hip">
    <visual><geometry>
      <mesh filename="package://spot_description/meshes/base/visual/rear_left_hip.obj"/>
    </geometry></visual>
  </link>

  <joint name="hl_hy" type="revolute">
    <parent link="hl_hip"/><child link="hl_uleg"/>
    <origin xyz="0.0 0.110945 0.0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="45" velocity="17.647" lower="-0.8989" upper="2.2951"/>
  </joint>
  <link name="hl_uleg">
    <visual><geometry>
      <mesh filename="package://spot_description/meshes/base/visual/rear_left_upper_leg.obj"/>
    </geometry></visual>
  </link>

  <joint name="hl_kn" type="revolute">
    <parent link="hl_uleg"/><child link="hl_lleg"/>
    <origin xyz="0.0 0.0 -0.3365" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="115" velocity="17.647" lower="-2.7928" upper="-0.2548"/>
  </joint>
  <link name="hl_lleg">
    <visual><geometry>
      <mesh filename="package://spot_description/meshes/base/visual/rear_left_lower_leg.obj"/>
    </geometry></visual>
  </link>

  <!-- ══ HIND-RIGHT LEG ════════════════════════════════════════════ -->
  <joint name="hr_hx" type="revolute">
    <parent link="base"/><child link="hr_hip"/>
    <origin xyz="-0.29785 -0.05500 0.00000" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit effort="45" velocity="17.647" lower="-0.7854" upper="0.7854"/>
  </joint>
  <link name="hr_hip">
    <visual><geometry>
      <mesh filename="package://spot_description/meshes/base/visual/rear_right_hip.obj"/>
    </geometry></visual>
  </link>

  <joint name="hr_hy" type="revolute">
    <parent link="hr_hip"/><child link="hr_uleg"/>
    <origin xyz="0.0 -0.110945 0.0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="45" velocity="17.647" lower="-0.8989" upper="2.2951"/>
  </joint>
  <link name="hr_uleg">
    <visual><geometry>
      <mesh filename="package://spot_description/meshes/base/visual/rear_right_upper_leg.obj"/>
    </geometry></visual>
  </link>

  <joint name="hr_kn" type="revolute">
    <parent link="hr_uleg"/><child link="hr_lleg"/>
    <origin xyz="0.0 0.0 -0.3365" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="115" velocity="17.647" lower="-2.7928" upper="-0.2548"/>
  </joint>
  <link name="hr_lleg">
    <visual><geometry>
      <mesh filename="package://spot_description/meshes/base/visual/rear_right_lower_leg.obj"/>
    </geometry></visual>
  </link>

  <!-- ══ ARM ═══════════════════════════════════════════════════════ -->
  <joint name="arm0_sh0" type="revolute">
    <parent link="base"/><child link="arm0_link_sh0"/>
    <origin xyz="0.292 0.0 0.188" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="220" velocity="10.0" lower="-3.14159" upper="3.14159"/>
  </joint>
  <link name="arm0_link_sh0">
    <visual><geometry>
      <mesh filename="package://spot_description/meshes/arm/visual/arm_link_sh0.obj"/>
    </geometry></visual>
  </link>

  <joint name="arm0_sh1" type="revolute">
    <parent link="arm0_link_sh0"/><child link="arm0_link_sh1"/>
    <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="220" velocity="10.0" lower="-3.14159" upper="3.14159"/>
  </joint>
  <link name="arm0_link_sh1">
    <visual><geometry>
      <mesh filename="package://spot_description/meshes/arm/visual/arm_link_sh1.obj"/>
    </geometry></visual>
  </link>

  <joint name="arm0_el0" type="revolute">
    <parent link="arm0_link_sh1"/><child link="arm0_link_el0"/>
    <origin xyz="0.3385 0.0 0.0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="110" velocity="10.0" lower="-3.14159" upper="3.14159"/>
  </joint>
  <link name="arm0_link_el0">
    <visual><geometry>
      <mesh filename="package://spot_description/meshes/arm/visual/arm_link_el0.obj"/>
    </geometry></visual>
  </link>

  <joint name="arm0_el1" type="revolute">
    <parent link="arm0_link_el0"/><child link="arm0_link_el1"/>
    <origin xyz="0.40330 0.0 0.0750" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit effort="30" velocity="10.0" lower="-3.14159" upper="3.14159"/>
  </joint>
  <link name="arm0_link_el1">
    <visual><geometry>
      <mesh filename="package://spot_description/meshes/arm/visual/arm_link_el1.obj"/>
    </geometry></visual>
  </link>

  <joint name="arm0_wr0" type="revolute">
    <parent link="arm0_link_el1"/><child link="arm0_link_wr0"/>
    <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="30" velocity="10.0" lower="-3.14159" upper="3.14159"/>
  </joint>
  <link name="arm0_link_wr0">
    <visual><geometry>
      <mesh filename="package://spot_description/meshes/arm/visual/arm_link_wr0.obj"/>
    </geometry></visual>
  </link>

  <joint name="arm0_wr1" type="revolute">
    <parent link="arm0_link_wr0"/><child link="arm0_link_wr1"/>
    <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="30" velocity="10.0" lower="-3.14159" upper="3.14159"/>
  </joint>
  <link name="arm0_link_wr1">
    <visual><geometry>
      <mesh filename="package://spot_description/meshes/arm/visual/arm_link_wr1.obj"/>
    </geometry></visual>
  </link>

  <joint name="arm0_f1x" type="revolute">
    <parent link="arm0_link_wr1"/><child link="arm0_link_fngr"/>
    <origin xyz="0.11745 0.0 0.014820" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit effort="30" velocity="10.0" lower="-1.5708" upper="0.0"/>
  </joint>
  <link name="arm0_link_fngr">
    <visual><geometry>
      <mesh filename="package://spot_description/meshes/arm/visual/arm_link_fngr.obj"/>
    </geometry></visual>
  </link>

</robot>
